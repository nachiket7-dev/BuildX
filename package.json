{
  "name": "buildx",
  "version": "1.0.0",
  "private": true,
  "description": "BuildX — AI-powered full-stack app blueprint generator",
  "workspaces": ["backend", "frontend", "desktop"],
  "scripts": {
    "dev": "concurrently --names \"API,UI\" --prefix-colors \"magenta,cyan\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "start": "npm run start --workspace=backend",
    "install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend",
    "desktop:dev": "npm start --workspace=desktop",
    "desktop:package": "npm run package --workspace=desktop --",
    "desktop:test": "npm test --workspace=desktop"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
