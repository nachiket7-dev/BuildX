# ─── BuildX Frontend Environment Variables ──────────────────
# Copy this file to .env and fill in your values

# Backend API URL
# Development: leave empty — Vite proxies /api → localhost:3001
# Production: set to your deployed backend URL, e.g. https://buildx-api.railway.app
VITE_API_URL=

# GitHub OAuth App client ID (must match backend GITHUB_CLIENT_ID)
VITE_GITHUB_CLIENT_ID=your_github_client_id
