{
  "name": "buildx-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/scripts/*.test.js test/evaluation-policy.cjs test/evaluation-compare.cjs test/application-fixtures.cjs test/provider-retry.cjs",
    "test:stack": "npm run build && node dist/scripts/testStackIntegration.js",
    "test:http": "npm run build && node test/agent-http.cjs",
    "test:models": "npm run build && node test/model-tools.cjs",
    "test:sandbox": "npm run build && node test/sandbox-check.cjs",
    "test:matrix": "npm run build && node test/generated-matrix.cjs",
    "test:postgres": "npm run build && node test/postgres-agent.cjs",
    "test:mongo": "npm run build && node test/mongo-runtime.cjs",
    "evaluate": "npm run build && node evaluation/run.cjs",
    "test:identity": "npm run build && node test/identity-runtime.cjs",
    "test:nemotron": "npm run build && node test/nemotron-live.cjs",
    "test:evaluation-fixtures": "npm run build && node test/evaluation-fixtures.cjs",
    "worker": "node dist/agent-worker.js",
    "test:queue": "npm run build && node test/queue-postgres.cjs && node test/queue-http.cjs && node test/queue-process.cjs && node test/queue-blueprint.cjs && node test/queue-spec.cjs && node test/queue-operations.cjs",
    "agent:maintenance": "node dist/agent-maintenance.js",
    "test:queue-engine": "npm run build && node test/queue-engine.cjs",
    "test:release-drill": "npm run build && node test/queue-release-drill.cjs",
    "test:identity-login": "npm run build && node test/identity-login.cjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "zod": "^3.22.4",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0"
  }
}
