# ─── BuildX Backend Environment Variables ───────────────────
# Copy this file to .env and fill in your values

# Required: Your Groq API key (FREE at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Optional: NVIDIA API key for Nemotron-3 Ultra 550B (build.nvidia.com)
# Model: nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=nvapi-your_key_here

# Optional: Google AI Studio API key for Gemini Flash
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_key_here

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/buildx

# Optional: emergency dev-only JSON store if Postgres is unreachable (NOT for production)
# ALLOW_DB_FALLBACK=true

# Optional: share LLM cooldowns across multiple backend instances using PostgreSQL
# LLM_SHARED_COOLDOWNS=true

# Required: Secret key for signing JWT auth tokens
JWT_SECRET=generate-a-random-64-char-string-here

# Server port (default: 3001)
PORT=3001

# Environment: development | production
NODE_ENV=development

# Model candidates remain opt-in until application-level evaluation passes.
# baseline retains the current Gemini author/reviewer pair.
# free-specialists uses North Mini Code for <=3-file edits, Laguna S for larger
# edits/codegen, and (with prototype opt-in) Nemotron Super for specifications.
# Explicit user model selections take precedence. At most 6 specialist attempts
# per run, including failed calls and reviews; the allowance survives checkpoints.
AGENT_MODEL_PROFILE=baseline
# NVIDIA free endpoints (including OpenRouter NVIDIA variants) are prototype-only.
# This switch is never honoured with NODE_ENV=production.
AGENT_ALLOW_PROTOTYPE_MODELS=false
# OpenRouter checks current zero pricing and quota before each call. Only explicit
# :free variants are allowed. Poolside free endpoints may use submitted code for
# training: evaluate with public/synthetic projects and review provider data terms.

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Optional: GitHub OAuth for login and repository export
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Agent verification: prebuilt image with the approved project toolchain.
# Docker must be running. Missing configuration is reported as unverified.
# AGENT_SANDBOX_IMAGE=buildx-checks:local
# With DATABASE_URL, run journals and workspace locks use PostgreSQL.
# Without PostgreSQL, persist this local journal directory on a single worker.
# AGENT_RUN_DIRECTORY=/var/lib/buildx/agent-runs

# Opt-in durable candidate jobs (PostgreSQL required). Enable the matching frontend queue flag at rollout.
# Start a separate worker from backend/: npm run build && npm run worker
# Start the worker before submitting jobs; it initializes the queue schema.
# Enable on BOTH API and worker only after staging configuration and billing review.
# AGENT_QUEUE_ENABLED=false

# Shared admission controls across API replicas (PostgreSQL-backed)
# AGENT_MAX_ACTIVE_PER_OWNER=2
# AGENT_MAX_ACTIVE_TOTAL=8
# AGENT_REQUESTS_PER_MINUTE=6
# Terminal job artifacts expire only when maintenance is explicitly run.
# Minimum 7 days; project specifications/files are never removed by retention.
# AGENT_RETENTION_DAYS=30
# npm run agent:maintenance                 # dry-run
# npm run agent:maintenance -- --apply       # archive old job artifacts
# npm run agent:maintenance -- --health      # worker/queue health; nonzero without a recent worker
